# The recording settings every tape shares (through common.tape, or
# vim.tape's own launch). FontSize 20 at this size is about 105 columns by
# 34 rows, so the text stays readable when GitHub scales an image down to its
# README column.

Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 20
Set Width 1400
Set Height 960
Set Padding 12
Set Theme "Catppuccin Mocha"
