# The recording settings every tape shares (through common.tape, or
# vim.tape's own launch). FontSize 22 at this width is about 100 columns, so
# the text stays readable when GitHub scales an image down to its README
# column.

Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 22
Set Width 1400
Set Height 860
Set Padding 12
Set Theme "Catppuccin Mocha"
