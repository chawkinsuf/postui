#!/bin/sh
# Refuses a commit whose Rust code is not rustfmt-clean, the same check CI
# runs. Installed by scripts/install-hooks.sh.

# Nothing Rust staged: nothing to check.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.rs$|(^|/)rustfmt\.toml$'; then
    exit 0
fi

cargo=$(command -v cargo || echo "$HOME/.cargo/bin/cargo")
if [ ! -x "$cargo" ]; then
    echo "pre-commit: cargo not found; skipping the format check" >&2
    exit 0
fi

# rustfmt itself has to run first: rust-toolchain.toml pins a release that
# rustup may not have installed (and can't fetch offline or with a read-only
# rustup home), and that failure is not a formatting one.
if ! fmt_version=$("$cargo" fmt --version 2>&1); then
    echo "pre-commit: cargo fmt could not run:" >&2
    echo "$fmt_version" | sed 's/^/    /' >&2
    echo "Install the toolchain rust-toolchain.toml pins, then commit again:" >&2
    echo "    rustup toolchain install" >&2
    exit 1
fi

if ! unformatted=$("$cargo" fmt --all --check -- --files-with-diff 2>&1); then
    echo "pre-commit: not formatted:" >&2
    echo "$unformatted" | sed 's/^/    /' >&2
    echo "Run:" >&2
    echo "    cargo fmt --all" >&2
    echo "then stage the result and commit again." >&2
    exit 1
fi
